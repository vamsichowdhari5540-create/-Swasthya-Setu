PORT=4000

# Create a free project at https://supabase.com, then Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY is a secret: keep it only in this backend .env,
# never in the mobile app or a committed file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional (Phase 7). Without it, AI summaries fall back to the
# deterministic template — the feature still works, just without the
# Groq-hosted rewrite/triage signal.
GROQ_API_KEY=
