PORT=4000

# Create a free project at https://supabase.com, then Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY is a secret: keep it only in this backend .env,
# never in the mobile app or a committed file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional (Phase 7), but recommended: two independent cloud model
# adapters, tried in order (Groq, then Gemini), so one vendor's outage or a
# decommissioned model doesn't take the AI summary feature down with it.
# Without either, summaries fall back to the deterministic template — the
# feature always works, just without a model-authored rewrite or triage
# signal.
GROQ_API_KEY=

# Free at https://aistudio.google.com/apikey — no credit card needed.
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins for CORS and Socket.IO,
# e.g. https://swasthyasetu.vercel.app,https://swasthyasetu-admin.vercel.app
# Leave unset during local development (no restriction). Set this once the
# real deployed frontend URLs are known — an unset value in production
# means any website can call this API.
CORS_ORIGINS=

# Off by default (unset or anything other than "true") — the reset
# endpoint deletes the append-only audit trail along with all test data,
# on request. Set to "true" here for local dev convenience; on a real
# deployment, only set it for the window a live demo actually needs it,
# then unset it again.
ALLOW_DEMO_RESET=true
