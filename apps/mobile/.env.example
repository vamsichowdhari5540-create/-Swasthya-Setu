EXPO_PUBLIC_API_URL=http://localhost:4000

# Safe to ship in the mobile bundle: this is Supabase's publishable/anon key,
# not a secret — it only works within the RLS policies defined in
# supabase/schema.sql. The service role key never goes here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: override the default openrelay.metered.ca demo TURN relay with
# your own (Metered.ca, Twilio NTS, etc.) for real off-LAN teleconsult use.
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=
